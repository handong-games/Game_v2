.card-board {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.card-board__area {
    width: 672px;
    height: 298px;
    position: relative;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: var(--motion-duration-normal-250ms);
    transition-timing-function: ease-out;
}

.card-board__area--refresh-hidden {
    opacity: 0;
    translate: 48px 0;
}

.card-board__center-area {
    width: 224px;
    height: 298px;
    justify-content: center;
    align-items: center;
}

.card-board__slot {
    position: absolute;
    width: 0;
    height: 0;
}

.card-board__card-anchor {
    position: absolute;
    left: -120px;
    top: -275px;
    width: 240px;
    height: 550px;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
    transition-property: opacity, scale, translate;
    transition-duration: var(--motion-duration-normal-250ms);
    transition-timing-function: ease-in;
}

.card-board__card-anchor--enter-pending {
    opacity: 0;
    scale: 0.92 0.92;
    translate: 0 24px;
}

.card-board__card-anchor--enter {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
    transition-property: opacity, scale, translate;
    transition-duration: var(--motion-duration-long-700ms);
    transition-timing-function: ease-out;
}

.card-board__card-anchor--exit {
    opacity: 0;
    scale: 0.92 0.92;
    translate: 0 24px;
}

.card-board__card-anchor--death {
    opacity: 0;
    scale: 0.84 0.84;
    translate: 0 28px;
    transition-property: opacity, scale, translate;
    transition-duration: var(--motion-duration-medium-400ms);
    transition-timing-function: ease-in;
}

.card-board__card {
    width: 100%;
    height: 100%;
    position: relative;
}

.card-board__card--deal-enter {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
    transition-property: opacity, scale, translate;
    transition-duration: var(--motion-duration-long-700ms);
    transition-timing-function: ease-out;
}

.card-board__card--deal-settle {
    scale: 0.98 0.98;
    translate: 0 2px;
    transition-property: scale, translate;
    transition-duration: var(--motion-duration-instant-80ms);
    transition-timing-function: ease-out;
}

.card-board__card--deal-settle-release {
    scale: 1 1;
    translate: 0 0;
    transition-property: scale, translate;
    transition-duration: var(--motion-duration-instant-80ms);
    transition-timing-function: ease-out;
}

.card-board__card-template {
    width: 100%;
    height: 100%;
}

.card-board__health-widget-area {
    position: absolute;
    left: 0;
    right: 0;
    top: -24px;
    align-items: center;
}

.card-board__health-widget {
    flex-shrink: 0;
}

.card--target-hover {
    translate: 0 -8px;
    transition-property: translate;
    transition-duration: var(--motion-duration-fast-120ms);
    transition-timing-function: ease-out;
}
