.adventure-monster-card {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: column;
    align-items: center;
    overflow: visible;
}

.adventure-monster-card__intent-widget {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 4px;
}

.adventure-monster-card__health-widget {
    position: relative;
    margin-top: 72px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.adventure-monster-card__card {
    position: relative;
    width: 240px;
    height: 358px;
    flex-shrink: 0;
}

.intent-badge {
    width: 52px;
    height: 52px;
    position: relative;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.82 0.82;
    transition-property: opacity, scale, translate;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.intent-badge--revealed {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.intent-badge--hidden {
    opacity: 0;
    scale: 0.82 0.82;
    translate: 0 8px;
}

.intent-badge--triggered {
    opacity: 0;
    scale: 0.72 0.72;
    translate: 0 -10px;
}

.intent-badge--refresh {
    scale: 1.12 1.12;
}

.intent-badge__icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.intent-badge__number {
    position: absolute;
    left: -10px;
    bottom: -6px;
    min-width: 28px;
    height: 24px;
    margin: 0;
    padding: 0 3px;
    color: rgb(255, 244, 218);
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(32, 26, 23);
}
