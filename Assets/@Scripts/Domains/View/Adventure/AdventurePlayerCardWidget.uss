.adventure-player-card {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: column;
    align-items: center;
    overflow: visible;
}

.adventure-player-card__health-widget {
    position: relative;
    margin-top: 72px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.adventure-player-card__card {
    position: relative;
    width: 240px;
    height: 358px;
    flex-shrink: 0;
}
