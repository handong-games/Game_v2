.title-screen__logo,
.title-screen__menu,
.title-screen__footer {
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate;
    transition-duration: var(--motion-duration-long-700ms);
    transition-timing-function: ease-out;
}

.title-screen__menu-label {
    scale: 1;
    translate: 0 0;
    transition-property: color, opacity, translate, text-shadow, scale, letter-spacing, -unity-text-outline-width, -unity-text-outline-color;
    transition-duration: var(--motion-duration-long-700ms);
    transition-timing-function: ease;
}

.title-screen__menu-button:hover .title-screen__menu-label,
.title-screen__menu-button--focused .title-screen__menu-label {
    color: rgba(255, 255, 255, 1);
    scale: 1.125;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.98);
}

.title-screen__menu-button:active .title-screen__menu-label {
    color: rgba(236, 236, 236, 0.98);
    scale: 1;
    -unity-text-outline-width: 1.7px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.98);
}

.title-screen--intro-shown .title-screen__logo,
.title-screen--intro-shown .title-screen__menu,
.title-screen--intro-shown .title-screen__footer {
    opacity: 1;
    translate: 0 0;
}

.title-screen--intro-shown .title-screen__logo {
    transition-delay: 0ms, 0ms;
}

.title-screen--intro-shown .title-screen__menu {
    transition-delay: 700ms, 700ms;
}

.title-screen--intro-shown .title-screen__footer {
    transition-delay: 1400ms, 1400ms;
}
